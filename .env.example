# Copy to .env and adjust. Values shown are the defaults.

# Where accounts and calendars are stored. Back this up; it is the whole state.
DATA_DIR=./data

HOST=0.0.0.0
PORT=8080

# Set to false for a private instance, so nobody can create an account.
ALLOW_REGISTRATION=true

# How long a session lasts before the user signs in again.
TOKEN_TTL_DAYS=365

# Requests per minute against /api/auth/register and /api/auth/login, per
# client address. Keeps password guessing expensive.
AUTH_RATE_LIMIT_PER_MINUTE=20

# Serve the built PWA from the API. Keep true unless you host the frontend
# separately; cookie sessions rely on both sharing an origin.
SERVE_WEB=true
# WEB_ROOT=./apps/web/dist
